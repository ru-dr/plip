{
  "name": "@ru-dr/plip",
  "version": "1.2.0",
  "description": "A delightful, colorful logging experience for modern applications",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:clean && bun run build:esm && bun run build:cjs && bun run build:finalize",
    "build:clean": "rm -rf dist",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "dev": "bun run src/index.ts",
    "prepublishOnly": "bun run typecheck && bun run lint && bun test && bun run build",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "version:prerelease": "npm version prerelease --no-git-tag-version",
    "release": "bun run build && bun test && npm publish",
    "release:beta": "bun run build && bun test && npm publish --tag beta",
    "release:github": "git push origin --tags && gh release create",
    "release:full": "bun run build && bun test && npm publish && bun run release:github",
    "docs:dev": "vitepress dev ../../docs",
    "docs:build": "vitepress build ../../docs",
    "docs:preview": "vitepress preview ../../docs",
    "docs:build:vercel": "bun install && vitepress build ../../docs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:finalize": "node scripts/prepare-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:coverage": "bun test --coverage"
  },
  "keywords": [
    "logger",
    "logging",
    "console",
    "colorful",
    "typescript",
    "minimal",
    "modern",
    "syntax-highlighting",
    "colors",
    "cli"
  ],
  "author": "rudra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ru-dr/plip.git"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/bun": "latest",
    "eslint": "^9.15.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.15.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "node": ">=16"
  },
  "sideEffects": false
}
